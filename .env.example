# ==================== 太空舱宣传视频生成 Agent 环境变量配置 ====================
#
# 使用说明：
#   1. 将此文件复制为 .env
#   2. 填入你的 API 密钥
#   3. .env 文件不会被提交到 Git

# ==================== API 配置 ====================

# 阿里云 DashScope (灵积) API 密钥
DASHSCOPE_API_KEY=your_api_key_here

# DashScope API 服务地址（通常无需修改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ==================== 图像生成配置（无参考图时生成虚拟参考图） ====================

IMAGE_MODEL=wan2.7-image-pro
DEFAULT_IMAGE_SIZE=2K

# ==================== 视频生成配置 ====================

# 视频生成模型：happyhorse-1.1-r2v（多参考图生视频，默认）
# 备选：wanx2.1-i2v-plus（单首帧图生视频）、wanx2.6-i2v、kenburns（图片运镜拼接兜底）
VIDEO_MODEL=happyhorse-1.1-r2v

# 视频分辨率（480P/720P/1080P，视模型而定）
VIDEO_RESOLUTION=720P

# 视频宽高比（happyhorse 支持，如 16:9 / 9:16 / 1:1）
VIDEO_RATIO=16:9

# 视频时长（秒）
VIDEO_DURATION=5

# ==================== 批量生成 ====================

# 每次「一键生成」生成的视频条数
DAILY_VIDEO_COUNT=5

# ==================== 参考图 ====================

# auto（默认）：assets/references 目录有参考图则用参考图驱动视频，无则回退生成虚拟参考图
# true ：强制使用参考图
# false：不使用参考图
USE_REFERENCE_IMAGE=auto

# ==================== 输出目录 ====================

# 参考图目录（默认项目内 assets/references）
REFERENCES_DIR=./assets/references

# 输出目录（虚拟参考图 + 视频 + 归档索引）
OUTPUT_DIR=./data/output
